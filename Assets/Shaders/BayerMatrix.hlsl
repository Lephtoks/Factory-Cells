static const float bayerMatrix[8][8] = {
    { 0, 32,  8, 40,  2, 34, 10, 42},
    {48, 16, 56, 24, 50, 18, 58, 26},
    {12, 44,  4, 36, 14, 46,  6, 38},
    {60, 28, 52, 20, 62, 30, 54, 22},
    { 3, 35, 11, 43,  1, 33,  9, 41},
    {51, 19, 59, 27, 49, 17, 57, 25},
    {15, 47,  7, 39, 13, 45,  5, 37},
    {63, 31, 55, 23, 61, 29, 53, 21}
};

void BayerDither_float(float2 uv, float2 spriteSize, out float dither)
{
    // Переводим UV в пиксельные координаты спрайта
    float2 pixel = uv * spriteSize;
    
    // Берём целую часть и находим позицию внутри 8×8 матрицы
    int x = (int)fmod(floor(pixel.x), 8.0);
    int y = (int)fmod(floor(pixel.y), 8.0);
    
    // Защита от отрицательных значений (на всякий случай)
    x = (x + 8) % 8;
    y = (y + 8) % 8;
    
    dither = bayerMatrix[y][x] / 64.0;
}