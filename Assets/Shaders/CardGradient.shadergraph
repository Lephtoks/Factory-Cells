    "m_FunctionBody": "void BayerDither8x8_float(\n    float2 UV,\n    float Threshold,\n    float Scale,\n    out float Result\n)\n{\n    // Экранные координаты в пикселях\n    float2 pixel = UV * _ScreenParams.xy * Scale;\n\n    // Координаты внутри матрицы 8x8\n    int2 p = int2(\n        fmod(floor(pixel.x), 8.0),\n        fmod(floor(pixel.y), 8.0)\n    );\n\n    int x = p.x;\n    int y = p.y;\n\n    // Bayer 8x8\n    int index = y * 8 + x;\n\n    int bayer[64] =\n    {\n         0, 48, 12, 60, 16, 32,  4, 52,\n         3, 51, 15, 63, 19, 35,  7, 55,\n        12, 60,  0, 48, 28, 44, 16, 32,\n        15, 63,  3, 51, 31, 47, 19, 35,\n         4, 52,  8, 56, 20, 36, 24, 40,\n         7, 55, 11, 59, 23, 39, 27, 43,\n        16, 32, 20, 36,  0, 48,  4, 52,\n        19, 35, 23, 39,  3, 51,  7, 55\n    };\n\n    float threshold = (bayer[index] + 0.5) / 64.0;\n\n    Result = step(threshold, Threshold);\n}"
}

